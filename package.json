{
  "name": "@1abcdefggs/vect-or-engine",
  "version": "0.3.3",
  "description": "Ultra-fast local-first vector search (HNSW + SIMD) and real-time semantic document linting native engine in Rust with zero-overhead N-API bindings for Node.js and Electron.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vector-search",
    "hnsw",
    "similarity-search",
    "rust",
    "n-api",
    "electron",
    "linter",
    "semantic-search",
    "embeddings",
    "knowledge-base",
    "simd",
    "aho-corasick",
    "offline-ai",
    "local-first",
    "monaco-editor",
    "text-validation"
  ],
  "author": "1abcdefggs <https://github.com/1abcdefggs>",
  "homepage": "https://github.com/1abcdefggs/vect-or-engine#readme",
  "bugs": {
    "url": "https://github.com/1abcdefggs/vect-or-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1abcdefggs/vect-or-engine.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "napi": {
    "name": "vect-or-engine",
    "version": "0.3.3",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^18.19.3"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "test": "node test/test-napi.js",
    "start-mcp": "node mcp/server.mjs",
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "version": "napi version"
  }
}
